<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude VPN configs (contains passwords) from cloud backup -->
        <exclude domain="sharedpref" path="vpn.xml"/>
    </cloud-backup>
    <device-transfer>
        <!-- Exclude VPN configs (contains passwords) from device-to-device transfer -->
        <exclude domain="sharedpref" path="vpn.xml"/>
    </device-transfer>
</data-extraction-rules>